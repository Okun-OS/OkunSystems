generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  password          String
  role              String    @default("CLIENT") // ADMIN | CLIENT | CLOSER
  portalRole        String?
  image             String?
  firstLogin        Boolean   @default(true)
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorCode     String?
  twoFactorExpiry   DateTime?
  twoFactorSentAt   DateTime?
  twoFactorAttempts Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  companyId String?
  company   Company? @relation("CompanyUsers", fields: [companyId], references: [id])

  appointments          Appointment[]
  notes                 Note[]
  tickets               RetainerTicket[]
  learningReviews       LearningProposal[]
  createdInvitations    Invitation[]
  managedAssignments    CustomerLearningAssignment[]
  uploadedDocuments     Document[]
  lessonProgress        LessonProgress[]
  activityLogs          ActivityLog[]
  // Sales & Closing
  assignedLeads         Company[]        @relation("CompanyCloser")
  closerSessions        ClosingSession[] @relation("CloserUser")
  createdOfferTemplates OfferTemplate[]
  createdOffers         Offer[]          @relation("OfferCreatedBy")
  createdInvoices       Invoice[]        @relation("InvoiceCreatedBy")
  confirmedInvoices     Invoice[]        @relation("InvoiceConfirmedBy")
  createdLegalDocs      LegalDocument[]
  closingEvents         ClosingEvent[]
}

model Company {
  id            String   @id @default(cuid())
  name          String
  industry      String?
  website       String?
  phone         String?
  address       String?
  logoUrl       String?
  status        String   @default("ONBOARDING")
  plan          String?
  contactPerson String?
  projectPhase  String   @default("onboarding")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Sales & Closing — Pre-Sale fields
  leadStatus       String?   // prospect | closing_scheduled | in_progress | offer_presented | agreement_reached | consent_given | contract_closed | payment_pending | verloren | storniert | abgesagt
  leadSource       String?
  contractValue    Int?
  contractPackage  String?
  paymentMethod    String?   // stripe | invoice
  convertedAt      DateTime?
  closingNotes     String?
  assignedCloserId String?
  assignedCloser   User?    @relation("CompanyCloser", fields: [assignedCloserId], references: [id])

  users               User[]                      @relation("CompanyUsers")
  projects            Project[]
  appointments        Appointment[]
  documents           Document[]
  retainers           Retainer[]
  assessments         Assessment[]
  notes               Note[]
  analysisSessions    AnalysisSession[]
  processes           ProcessProfile[]
  detectedProblems    DetectedProblem[]
  opportunities       Opportunity[]
  okunScores          OkunScore[]
  memory              CompanyMemory?
  invitations         Invitation[]
  learningAssignments CustomerLearningAssignment[]
  activityLogs        ActivityLog[]
  careSubscription    CareSubscription?
  // Sales & Closing relations
  closingSessions     ClosingSession[]
  offers              Offer[]
  consentRecords      ConsentRecord[]
  invoices            Invoice[]
  closingEvents       ClosingEvent[]
}

model Project {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("PLANNING")
  phase       String?
  startDate   DateTime?
  endDate     DateTime?
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  isVisibleToClient Boolean   @default(false)

  companyId  String
  company    Company     @relation(fields: [companyId], references: [id])
  milestones Milestone[]
  tasks      Task[]
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  completedAt DateTime?
  isInternal  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

model Appointment {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("STRATEGY")
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  meetingUrl  String?
  status      String   @default("SCHEDULED")
  notes       String?
  bookedByName  String?
  bookedByEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  attendees         User[]
  analysisSessionId String?
  analysisSession   AnalysisSession? @relation(fields: [analysisSessionId], references: [id])
  closingSession    ClosingSession?
}

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("OTHER")
  fileUrl     String?
  fileName    String?
  fileSize    Int?
  mimeType    String?
  isPublished Boolean  @default(false)
  isInternal  Boolean  @default(false)
  version     String?
  r2Key       String?  // R2 object key for signed-URL generation
  visibility  String   @default("internal") // internal | customer
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId    String
  company      Company @relation(fields: [companyId], references: [id])
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])
}

model Retainer {
  id            String    @id @default(cuid())
  name          String
  type          String    @default("STANDARD")
  status        String    @default("ACTIVE")
  startDate     DateTime
  endDate       DateTime?
  hoursPerMonth Int       @default(10)
  usedHours     Int       @default(0)
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  tickets   RetainerTicket[]
}

model RetainerTicket {
  id          String    @id @default(cuid())
  title       String
  description String
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  type        String    @default("CHANGE_REQUEST")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  retainerId  String
  retainer    Retainer @relation(fields: [retainerId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model Note {
  id         String   @id @default(cuid())
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])
}

model Assessment {
  id          String    @id @default(cuid())
  status      String    @default("PENDING")
  score       Int?
  summary     String?
  isPublished Boolean   @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId       String
  company         Company              @relation(fields: [companyId], references: [id])
  responses       AssessmentResponse[]
  recommendations Recommendation[]
}

model AssessmentQuestion {
  id       String  @id @default(cuid())
  text     String
  category String
  type     String  @default("SCALE")
  options  String?
  weight   Int     @default(1)
  order    Int     @default(0)
  isActive Boolean @default(true)

  responses AssessmentResponse[]
}

model AssessmentResponse {
  id        String   @id @default(cuid())
  answer    String
  score     Int?
  createdAt DateTime @default(now())

  assessmentId String
  assessment   Assessment         @relation(fields: [assessmentId], references: [id])
  questionId   String
  question     AssessmentQuestion @relation(fields: [questionId], references: [id])
}

model Recommendation {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  priority    Int      @default(1)
  system      String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
}

// ─── OKUN Blueprint™ Engine Models ───────────────────────────────────────────

model AnalysisSession {
  id            String    @id @default(cuid())
  status        String    @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | ARCHIVED
  phase         String    @default("INTRO")  // INTRO | PROFIL | PROZESSE | TIEFE | SYSTEME | GESCHAEFTSFUEHRUNG | ABSCHLUSS
  currentArea   String?
  completedAreas String   @default("[]")
  hypotheses    String    @default("[]")
  memorySnapshot String   @default("{}")
  totalMessages Int       @default(0)
  language      String    @default("de")
  questionsAsked Int      @default(0)
  lastActiveAt  DateTime?
  startedAt     DateTime  @default(now())
  resumedAt     DateTime?
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  // Blueprint 2.0 fields
  blueprintVersion   String  @default("1.0")
  packageType        String?
  activeGroupWeights String  @default("{}")
  pendingReviewCount Int     @default(0)
  reportUrl          String?

  companyId String
  company   Company               @relation(fields: [companyId], references: [id])
  messages  ConversationMessage[]
  processes ProcessProfile[]
  problems  DetectedProblem[]
  opportunities Opportunity[]
  score     OkunScore?
  progress  SessionProgress[]
  evidence      ScoringEvidence[]
  appointments  Appointment[]
  sessionAnswers SessionAnswer[]
}

model ConversationMessage {
  id             String   @id @default(cuid())
  role           String   // "user" | "assistant"
  content        String
  internalNotes  String?  // JSON: internal advisor reasoning, hypotheses formed, signals detected
  memoryUpdates  String?  // JSON: what was stored to memory engine
  createdAt      DateTime @default(now())

  sessionId String
  session   AnalysisSession @relation(fields: [sessionId], references: [id])
}

model ProcessProfile {
  id            String   @id @default(cuid())
  name          String
  category      String   // from Process Library categories
  libraryRef    String?  // reference to ProcessLibraryItem id if matched
  isNew         Boolean  @default(false) // true if not in library → creates LearningProposal
  trigger       String?  // what starts this process
  goal          String?  // when is it successfully completed
  roles         String   @default("[]")  // JSON array of involved roles
  steps         String   @default("[]")  // JSON array of ProcessStep-like objects
  systems       String   @default("[]")  // JSON array of tools/files/channels used
  inputs        String   @default("[]")  // JSON: information sources
  handoffs      String   @default("[]")  // JSON: handoff points
  decisions     String   @default("[]")  // JSON: decision points
  documentation String?  // how is this documented
  frequency     String?  // how often does it occur
  problems      String   @default("[]")  // JSON: observed problems in this process
  maturityScore Int?     // 0-100 process maturity
  officialVsActual String? // discrepancy between official and actual process
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessionId String
  session   AnalysisSession @relation(fields: [sessionId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model DetectedProblem {
  id             String   @id @default(cuid())
  symptom        String   // what the customer described
  operativeProblem String // what the actual operative problem is
  rootCause      String?  // underlying root cause
  category       String   // process | structure | leadership | automation | communication | sales | hr
  severity       String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  confidence     Int      @default(50)       // 0-100 confidence score
  evidence       String   @default("[]")     // JSON array of evidence strings
  libraryRef     String?  // reference to ProblemLibraryItem if matched
  isNew          Boolean  @default(false)    // true if not in library → creates LearningProposal
  isInternal     Boolean  @default(true)     // internal only, not shown to customer
  processRef     String?  // reference to ProcessProfile id if applicable
  createdAt      DateTime @default(now())

  sessionId String
  session   AnalysisSession @relation(fields: [sessionId], references: [id])
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  opportunities Opportunity[]
}

model Opportunity {
  id           String   @id @default(cuid())
  title        String
  type         String   // AUTOMATION | DELEGATION | STANDARDIZATION | TRANSPARENCY | SCALING
  description  String
  impact       String   @default("MEDIUM")  // LOW | MEDIUM | HIGH | VERY_HIGH
  effort       String   @default("MEDIUM")  // LOW | MEDIUM | HIGH
  priority     Int      @default(2)          // 1=high, 2=medium, 3=low
  timeSaving   String?
  okunSystem   String?
  solutionType String?  // existing_okun_solution | configurable_solution | custom_automation | consulting_recommendation
  status       String   @default("identified") // identified | needs_review | recommended | accepted | rejected | converted_to_project
  evidence     String   @default("[]")
  isInternal   Boolean  @default(true)
  createdAt    DateTime @default(now())

  sessionId   String
  session     AnalysisSession  @relation(fields: [sessionId], references: [id])
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  problemId   String?
  problem     DetectedProblem? @relation(fields: [problemId], references: [id])
}

model OkunScore {
  id              String   @id @default(cuid())
  totalScore      Int      // 0-100
  maturityLevel   String   // INITIAL | DEVELOPING | DEFINED | MANAGED | OPTIMIZED
  maturityLabel   String   // German label for customer
  scoreProcesses  Int?     // 25% weight
  scoreSales      Int?     // 20% weight
  scoreLeadership Int?     // 15% weight
  scoreAutomation Int?     // 15% weight
  scoreStructure  Int?     // 10% weight
  scoreCommunication Int?  // 10% weight
  scoreHr         Int?     // 5% weight
  strengths       String   @default("[]")   // JSON: 3-5 strengths (shown to customer)
  potentials      String   @default("[]")   // JSON: 3-5 potential areas (shown to customer)
  internalSummary String?  // full internal analysis summary
  customerSummary String?  // short customer-facing summary
  evidence        String   @default("{}")   // JSON: evidence per area
  isPublished     Boolean  @default(false)
  calculatedAt    DateTime @default(now())
  publishedAt     DateTime?

  sessionId String @unique
  session   AnalysisSession @relation(fields: [sessionId], references: [id])
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
}

model ProcessLibraryItem {
  id          String   @id @default(cuid())
  name        String
  category    String   // Vertrieb | Kommunikation | Verwaltung | Personal | etc.
  description String
  typicalRoles String  @default("[]") // JSON
  typicalSystems String @default("[]") // JSON
  typicalProblems String @default("[]") // JSON
  frequency   String?
  isActive    Boolean  @default(true)
  isCustom    Boolean  @default(false) // true = added via learning proposal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProblemLibraryItem {
  id              String   @id @default(cuid())
  name            String
  symptomPatterns String   @default("[]") // JSON: keyword/phrase patterns that trigger detection
  operativeProblem String
  rootCause       String
  category        String
  severity        String   @default("MEDIUM")
  opportunities   String   @default("[]") // JSON: typical opportunities this creates
  okunSystems     String   @default("[]") // JSON: internal OKUN system references
  isActive        Boolean  @default(true)
  isCustom        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LearningProposal {
  id          String   @id @default(cuid())
  type        String   // NEW_PROCESS | NEW_PROBLEM | NEW_OPPORTUNITY
  title       String
  description String
  proposedData String  // JSON: full proposed entity data
  sourceSessionId String?
  sourceCompanyId String?
  evidence    String   @default("[]") // JSON
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote  String?
  reviewedAt  DateTime?
  reviewedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviewedBy User? @relation(fields: [reviewedById], references: [id])
}

model CompanyMemory {
  id          String   @id @default(cuid())
  companyId   String   @unique
  company     Company  @relation(fields: [companyId], references: [id])
  profile     String   @default("{}")
  roles       String   @default("[]")
  systems     String   @default("[]")
  challenges  String   @default("[]")
  goals       String   @default("[]")
  knowledgeDependencies String @default("[]")
  updatedAt   DateTime @updatedAt
}

model QuestionTemplate {
  id               String   @id @default(cuid())
  externalId       String   @unique
  area             String
  phase            String
  order            Int
  isRequired       Boolean  @default(true)
  intent           String
  questionDe       String
  questionEn       String
  followUpTriggers String   @default("[]")
  scoringCategory  String?
  scoringSignal    String?
  maxFollowUps     Int      @default(2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  // Blueprint 2.0 fields
  moduleNumber     Int?
  groupCode        String?
  questionType     String   @default("B")
  isGating         Boolean  @default(false)
  isFollowUp       Boolean  @default(false)
  parentExternalId String?
  internalWeight   Float?
  activationConds  String   @default("[]")

  progress         SessionProgress[]
  answerOptions    AnswerOption[]
  sessionAnswers   SessionAnswer[]
  branchingFrom    BranchingRule[]  @relation("BranchingSource")
  branchingTo      BranchingRule[]  @relation("BranchingTarget")
}

model AnswerOption {
  id             String          @id @default(cuid())
  externalId     String          @unique
  questionId     String
  question       QuestionTemplate @relation(fields: [questionId], references: [id])
  textDe         String
  points         Int             @default(0)
  isExclusive    Boolean         @default(false)
  signalCategory String?
  signalValue    Int             @default(0)
  order          Int             @default(0)
  isActive       Boolean         @default(true)
}

model BranchingRule {
  id               String          @id @default(cuid())
  sourceQuestionId String
  sourceQuestion   QuestionTemplate @relation("BranchingSource", fields: [sourceQuestionId], references: [id])
  targetQuestionId String
  targetQuestion   QuestionTemplate @relation("BranchingTarget", fields: [targetQuestionId], references: [id])
  conditionType    String
  conditionValue   String          @default("{}")
  action           String
  priority         Int             @default(0)
  description      String?
  createdAt        DateTime        @default(now())
}

model SessionAnswer {
  id                String          @id @default(cuid())
  sessionId         String
  session           AnalysisSession @relation(fields: [sessionId], references: [id])
  questionId        String
  question          QuestionTemplate @relation(fields: [questionId], references: [id])
  selectedOptionIds String          @default("[]")
  freeText          String?
  computedScore     Int?
  computedSignals   String          @default("{}")
  status            String          @default("ANSWERED")
  pendingReview     Boolean         @default(false)
  answeredAt        DateTime        @default(now())

  @@unique([sessionId, questionId])
}

model SolutionLibrary {
  id                   String   @id @default(cuid())
  externalId           String   @unique
  name                 String
  category             String
  description          String
  packageTypes         String   @default("[]")
  activationConditions String   @default("[]")
  exclusionConditions  String   @default("[]")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
}

model SessionProgress {
  id            String   @id @default(cuid())
  sessionId     String
  session       AnalysisSession   @relation(fields: [sessionId], references: [id])
  questionId    String
  question      QuestionTemplate  @relation(fields: [questionId], references: [id])
  askedAt       DateTime?
  answeredAt    DateTime?
  answerSummary String?
  skipped       Boolean  @default(false)
  followUpsUsed Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([sessionId, questionId])
}

model ScoringEvidence {
  id          String   @id @default(cuid())
  sessionId   String
  session     AnalysisSession @relation(fields: [sessionId], references: [id])
  category    String
  signal      String
  weight      Int
  description String
  messageId   String?
  createdAt   DateTime @default(now())
}

// ─── OKUN Client Platform Models ─────────────────────────────────────────────

model Invitation {
  id          String    @id @default(cuid())
  token       String    @unique @default(uuid())
  email       String
  role        String    @default("CLIENT")
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
}

model LearningCategory {
  id          String            @id @default(cuid())
  title       String
  description String?
  order       Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  chapters    LearningChapter[]
}

model LearningChapter {
  id               String                       @id @default(cuid())
  title            String
  description      String?
  contentType      String                       @default("mixed") // video | text | pdf | mixed
  thumbnailR2Key   String?
  order            Int                          @default(0)
  estimatedMinutes Int?
  status           String                       @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  availability     String                       @default("strategy_session") // immediate | strategy_session
  isActive         Boolean                      @default(true)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  categoryId  String
  category    LearningCategory             @relation(fields: [categoryId], references: [id])
  lessons     LearningLesson[]
  tags        LearningChapterTag[]
  assignments CustomerLearningAssignment[]
  packageAssignments PackageDefaultLearningAssignment[]
}

model LearningLesson {
  id               String           @id @default(cuid())
  title            String
  description      String?
  contentType      String           @default("video") // video | text | pdf
  r2Key            String?
  externalUrl      String?
  order            Int              @default(0)
  estimatedMinutes Int?
  status           String           @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  chapterId String
  chapter   LearningChapter  @relation(fields: [chapterId], references: [id])
  progress  LessonProgress[]
}

model LearningTag {
  id             String               @id @default(cuid())
  name           String               @unique
  signalCategory String?

  chapters LearningChapterTag[]
}

model LearningChapterTag {
  chapterId String
  chapter   LearningChapter @relation(fields: [chapterId], references: [id])
  tagId     String
  tag       LearningTag     @relation(fields: [tagId], references: [id])

  @@id([chapterId, tagId])
}

model CustomerLearningAssignment {
  id            String    @id @default(cuid())
  status        String    @default("suggested") // suggested | active | rejected
  assignedAt    DateTime  @default(now())
  activatedAt   DateTime?
  rejectedAt    DateTime?
  rejectionNote String?
  sessionId     String?   // Blueprint session that triggered the suggestion

  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  chapterId    String
  chapter      LearningChapter @relation(fields: [chapterId], references: [id])
  assignedById String
  assignedBy   User            @relation(fields: [assignedById], references: [id])

  @@unique([companyId, chapterId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  status      String    @default("not_started") // not_started | in_progress | completed
  progressPct Int       @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  userId   String
  user     User           @relation(fields: [userId], references: [id])
  lessonId String
  lesson   LearningLesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
}

model SystemSetting {
  key       String   @id
  value     String
  label     String   @default("")
  group     String   @default("general") // invoice | legal | activation | general
  updatedAt DateTime @updatedAt
}

model CareSubscription {
  id                   String    @id @default(cuid())
  status               String    @default("inactive") // inactive | active | cancelled
  stripeCustomerId     String?
  stripeSubscriptionId String?
  startedAt            DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])
}

// ─── OKUN Sales & Closing Module ─────────────────────────────────────────────

model LegalDocument {
  id            String   @id @default(cuid())
  type          String   // agb | datenschutz | leistungsbedingungen | avv | recording_consent | vertragsunterlagen | sonstiges
  title         String
  version       String
  description   String?
  r2Key         String
  mimeType      String   @default("application/pdf")
  isActive      Boolean  @default(false)
  isRequired    Boolean  @default(true)
  displayOrder  Int      @default(0)
  checkboxLabel String?
  linkText      String?
  createdAt     DateTime @default(now())

  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id])
  consentRecords ConsentRecord[]
}

model ClosingSession {
  id               String    @id @default(cuid())
  status           String    @default("closing_scheduled")
  activeOfferId    String?
  currentStep      String?
  recordingStatus  String    @default("idle")
  dailyRecordingId String?
  recordingR2Key   String?
  clientTokenHash  String    @unique
  tokenExpiresAt   DateTime
  startedAt        DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  closerId      String
  closer        User         @relation("CloserUser", fields: [closerId], references: [id])

  offers           Offer[]
  consentRecords   ConsentRecord[]
  contractSnapshot ContractSnapshot?
  invoices         Invoice[]
  events           ClosingEvent[]
}

model OfferTemplate {
  id          String   @id @default(cuid())
  name        String
  packageType String
  description String?
  priceNet    Int
  currency    String   @default("EUR")
  lineItems   String   @default("[]")
  validDays   Int      @default(30)
  r2Key       String?
  status      String   @default("draft")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id])
  offers      Offer[]
}

model Offer {
  id               String    @id @default(cuid())
  status           String    @default("draft")
  currency         String    @default("EUR")
  priceNet         Int
  validUntil       DateTime
  presentedAt      DateTime?
  acceptedAt       DateTime?
  pdfR2Key         String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  templateId       String?
  template         OfferTemplate? @relation(fields: [templateId], references: [id])
  closingSessionId String?
  closingSession   ClosingSession? @relation(fields: [closingSessionId], references: [id])
  createdById      String
  createdBy        User           @relation("OfferCreatedBy", fields: [createdById], references: [id])

  lineItems      OfferLineItem[]
  consentRecords ConsentRecord[]
  invoices       Invoice[]
}

model OfferLineItem {
  id             String  @id @default(cuid())
  position       Int
  description    String
  quantity       Float   @default(1)
  unitPriceCents Int
  totalCents     Int
  isExtra        Boolean @default(false)
  note           String?

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id])
}

model ConsentRecord {
  id                  String    @id @default(cuid())
  consentType         String
  isRequired          Boolean
  offerVersion        Int       @default(1)
  displayedPriceCents Int
  displayedItems      String    @default("[]")
  offerDisplayedAt    DateTime?
  agreementAt         DateTime?
  result              String
  grantedAt           DateTime  @default(now())
  ipAddress           String?
  userAgent           String?
  sessionTokenHash    String

  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  closingSessionId String
  closingSession   ClosingSession @relation(fields: [closingSessionId], references: [id])
  offerId          String
  offer            Offer          @relation(fields: [offerId], references: [id])
  legalDocumentId  String
  legalDocument    LegalDocument  @relation(fields: [legalDocumentId], references: [id])
}

model Invoice {
  id                    String    @id @default(cuid())
  invoiceNumber         String    @unique
  status                String    @default("draft")
  netAmount             Int
  taxRate               Float     @default(0.19)
  grossAmount           Int
  currency              String    @default("EUR")
  dueDate               DateTime
  issuedAt              DateTime?
  paidAt                DateTime?
  paidBy                String?
  stripePaymentIntentId String?
  pdfR2Key              String?
  billingName           String?
  billingAddress        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  offerId          String?
  offer            Offer?          @relation(fields: [offerId], references: [id])
  closingSessionId String?
  closingSession   ClosingSession? @relation(fields: [closingSessionId], references: [id])
  createdById      String
  createdBy        User            @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  confirmedById    String?
  confirmedBy      User?           @relation("InvoiceConfirmedBy", fields: [confirmedById], references: [id])

  items InvoiceItem[]
}

model InvoiceItem {
  id          String @id @default(cuid())
  position    Int
  description String
  quantity    Float  @default(1)
  unitPrice   Int
  totalPrice  Int

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
}

model ContractSnapshot {
  id               String   @id @default(cuid())
  offerVersion     Int      @default(1)
  packageType      String
  totalNetCents    Int
  lineItems        String   @default("[]")
  extras           String   @default("[]")
  customChanges    String?
  offerDate        DateTime
  agbVersion       String
  privacyVersion   String
  otherDocVersions String   @default("{}")
  closedAt         DateTime
  closerName       String
  companyName      String
  fullSnapshot     String   @default("{}")
  createdAt        DateTime @default(now())

  closingSessionId String         @unique
  closingSession   ClosingSession @relation(fields: [closingSessionId], references: [id])
  offerId          String
  closerId         String
  companyId        String
}

model PackageDefaultLearningAssignment {
  id              String  @id @default(cuid())
  packageType     String
  assignmentOrder Int     @default(0)
  isActive        Boolean @default(true)

  chapterId String
  chapter   LearningChapter @relation(fields: [chapterId], references: [id])

  @@unique([packageType, chapterId])
}

model SalesContent {
  id                String   @id @default(cuid())
  type              String   // closing_script | objection | faq | package_info | guide | email_template
  category          String?
  title             String
  content           String
  order             Int      @default(0)
  isVisibleToClient Boolean  @default(false)
  status            String   @default("draft")
  version           Int      @default(1)
  r2Key             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EmailTemplate {
  id               String   @id @default(cuid())
  key              String   @unique
  subject          String
  bodyHtml         String
  attachmentConfig String   @default("[]")
  legalFooter      String?
  isActive         Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model ClosingEvent {
  id         String   @id @default(cuid())
  eventType  String
  metadata   String   @default("{}")
  reason     String?
  occurredAt DateTime @default(now())

  closingSessionId String
  closingSession   ClosingSession @relation(fields: [closingSessionId], references: [id])
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  actorId          String?
  actor            User?          @relation(fields: [actorId], references: [id])
}
